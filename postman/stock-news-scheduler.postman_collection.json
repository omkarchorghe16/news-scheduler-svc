{
  "info": {
    "name": "Stock News Scheduler Service",
    "description": "Shared Postman collection for local, AWS dev, and AWS production. Select the activeProfile in the imported environment.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const profile = pm.environment.get(\"activeProfile\");",
          "const baseUrls = {",
          "  local: pm.environment.get(\"localBaseUrl\"),",
          "  \"aws-dev\": pm.environment.get(\"awsDevBaseUrl\"),",
          "  \"aws-prod\": pm.environment.get(\"awsProdBaseUrl\")",
          "};",
          "const baseUrl = baseUrls[profile];",
          "if (!baseUrl) {",
          "  throw new Error(\"Set activeProfile to local, aws-dev, or aws-prod, and configure that profile's base URL.\");",
          "}",
          "pm.environment.set(\"baseUrl\", baseUrl.replace(/\\/+$/, \"\"));"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "apiPath",
      "value": "/api/digest",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Digest API",
      "item": [
        {
          "name": "Health Check",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {\n  pm.response.to.have.status(200);\n});\n",
                  "pm.test(\"Response body is running message\", function () {\n  pm.expect(pm.response.text()).to.include(\"Stock News Scheduler Service is running\");\n});\n"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}{{apiPath}}/health"
          },
          "response": []
        },
        {
          "name": "Trigger Daily Digest",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {\n  pm.response.to.have.status(200);\n});\n",
                  "pm.test(\"Digest execution message received\", function () {\n  pm.expect(pm.response.text()).to.include(\"Daily digest executed successfully\");\n});\n"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": ""
            },
            "url": "{{baseUrl}}{{apiPath}}/run"
          },
          "response": []
        },
        {
          "name": "Trigger Portfolio Digest",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {\n  pm.response.to.have.status(200);\n});\n",
                  "pm.test(\"Portfolio digest execution message received\", function () {\n  pm.expect(pm.response.text()).to.include(\"Portfolio digest executed successfully\");\n});\n"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": ""
            },
            "url": "{{baseUrl}}{{apiPath}}/portfolio"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Sector and Stock Management",
      "item": [
        {
          "name": "Create Sector",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"sectorName\", \"Postman Sector \" + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Sector is created\", function () { pm.response.to.have.status(201); });",
                  "var sector = pm.response.json();",
                  "pm.collectionVariables.set(\"sectorId\", sector.id);",
                  "pm.test(\"Response contains the created sector\", function () { pm.expect(sector.sectorName).to.eql(pm.collectionVariables.get(\"sectorName\")); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sectorName\": \"{{sectorName}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/sectors"
          },
          "response": []
        },
        {
          "name": "List Sectors",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Sector list is returned\", function () { pm.response.to.have.status(200); pm.expect(pm.response.json()).to.be.an(\"array\"); });",
                  "pm.test(\"Created sector is in the list\", function () { pm.expect(pm.response.json().some(function (sector) { return sector.id === Number(pm.collectionVariables.get(\"sectorId\")); })).to.eql(true); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/sectors"
          },
          "response": []
        },
        {
          "name": "Get Sector",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
