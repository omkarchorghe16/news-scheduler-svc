{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DescribeTaskDefinition",
      "Effect": "Allow",
      "Action": "ecs:DescribeTaskDefinition",
      "Resource": "*"
    },
    {
      "Sid": "RegisterNewsSchedulerTaskDefinition",
      "Effect": "Allow",
      "Action": "ecs:RegisterTaskDefinition",
      "Resource": "arn:aws:ecs:us-east-2:221934031392:task-definition/news-scheduler-svc:*"
    },
    {
      "Sid": "DescribeNewsSchedulerCluster",
      "Effect": "Allow",
      "Action": "ecs:DescribeClusters",
      "Resource": "arn:aws:ecs:us-east-2:221934031392:cluster/news-scheduler"
    },
    {
      "Sid": "DeployNewsSchedulerService",
      "Effect": "Allow",
      "Action": [
        "ecs:DescribeServices",
        "ecs:UpdateService"
      ],
      "Resource": "arn:aws:ecs:us-east-2:221934031392:service/news-scheduler/news-scheduler-svc",
      "Condition": {
        "ArnEquals": {
          "ecs:cluster": "arn:aws:ecs:us-east-2:221934031392:cluster/news-scheduler"
        }
      }
    },
    {
      "Sid": "PassEcsTaskExecutionRole",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::221934031392:role/news-scheduler-svc-EcsTaskExecutionRole-*",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "ecs-tasks.amazonaws.com"
        }
      }
    }
  ]
}
