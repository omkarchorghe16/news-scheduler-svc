# Local development configuration example for root/application-local.yml overrides.
# Keep actual secrets out of this file when possible; export environment variables instead.
# The local profile is the default; the packaged src/main/resources/application-local.yml
# enables the H2 console at /h2-console.

spring:
  h2:
    console:
      enabled: true
      path: /h2-console
  datasource:
    url: jdbc:h2:file:./data/news-scheduler;DB_CLOSE_DELAY=-1;DB_CLOSE_ON_EXIT=FALSE;MODE=PostgreSQL
  jpa:
    hibernate:
      ddl-auto: update
    show-sql: true

app:
  notifications:
    slack:
      webhook-url: ${SLACK_WEBHOOK_URL:}
      portfolio-webhook-url: ${SLACK_PORTFOLIO_WEBHOOK_URL:}
    telegram:
      bot-token: ${TELEGRAM_BOT_TOKEN:}
      chat-id: ${TELEGRAM_CHAT_ID:}
    whatsapp:
      enabled: false
      twilio-sid: ${TWILIO_ACCOUNT_SID:}
      twilio-token: ${TWILIO_AUTH_TOKEN:}
      from-number: ${TWILIO_WHATSAPP_FROM:}
      to-number: ${TWILIO_WHATSAPP_TO:}
  apis:
    finnhub-key: ${FINNHUB_API_KEY:}
    newsapi-key: ${NEWSAPI_KEY:}
    finnhub-base-url: ${FINNHUB_BASE_URL:https://finnhub.io/api/v1}
    yahoo-base-url: ${YAHOO_FINANCE_BASE_URL:https://query1.finance.yahoo.com}
    timeout-seconds: 10
    max-retries: 2
  watchlist:
    us-symbols:
      - AAPL
      - GOOGL
      - MSFT
    nse-symbols:
      - RELIANCE.NS
      - INFY.NS
      - TCS.NS
    portfolio-symbols:
      - AAPL
      - INFY.NS
  schedule:
    cron-expression: "0 */5 * * * *"  # Every 5 minutes for local testing
    timezone: "America/Chicago"

management:
  endpoint:
    health:
      show-details: never

logging:
  level:
    com.stocknews: DEBUG
    org.springframework.web: DEBUG
